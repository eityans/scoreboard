<h1 class="text-2xl font-bold mb-6">セッション編集</h1>
<% if @poker_session.recorded_live? %>
  <%= render "live_edit_form", poker_session: @poker_session %>
<% else %>
  <%= render "form", poker_session: @poker_session, players: @players %>
<% end %>
<div class="mt-4">
  <%= link_to "← セッション詳細", group_poker_session_path(@group, @poker_session), class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>
