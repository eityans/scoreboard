<div class="bg-white shadow-sm rounded-xl border border-gray-100 p-6 max-w-lg">
  <%= form_with(model: [@group, @poker_session, session_entry], class: "space-y-4") do |form| %>
    <% if session_entry.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
        <% session_entry.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= form.label :kind, "種類", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :kind, session_entry_kind_options(session_entry), {}, class: "w-full min-h-11 border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
    </div>

    <div data-controller="inline-player" data-inline-player-url-value="<%= group_players_path(@group) %>">
      <%= form.label :player_id, "プレイヤー", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :player_id, @players, :id, :display_name,
          { prompt: "プレイヤーを選択" },
          { class: "w-full min-h-11 border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" } %>
      <button type="button" data-action="inline-player#toggle" class="btn-outline-green w-full sm:w-auto mt-2 cursor-pointer">
        + 新しいプレイヤー
      </button>
      <div data-inline-player-target="form" class="hidden mt-3 flex items-center gap-2">
        <input type="text" data-inline-player-target="input" data-action="keydown.enter->inline-player#submit"
               placeholder="プレイヤー名" class="flex-1 min-h-11 border border-gray-300 rounded-lg px-3 focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition">
        <button type="button" data-action="inline-player#submit" class="btn-green cursor-pointer">追加</button>
        <button type="button" data-action="inline-player#toggle" class="btn-ghost cursor-pointer">キャンセル</button>
      </div>
    </div>

    <div>
      <%= form.label :amount, "点数（#{amount_unit_label(@group)}）", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :amount, step: 0.1, inputmode: "decimal", value: amount_input_value(session_entry.amount),
          class: "w-full min-h-11 border border-gray-300 rounded-lg px-3 text-right focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" %>
    </div>

    <%= form.submit session_entry.persisted? ? "変更を保存する" : "記録する", class: "btn-primary w-full cursor-pointer" %>
  <% end %>
</div>
